{% extends "monitor/base.html" %}
{% load tz %}
{% load timefmt %}

{% block content %}
<div class="card p-4 mb-4 glass">
  <div class="d-flex justify-content-between flex-wrap">
    <div>
      <p class="section-title mb-1">Packet Stream</p>
      <h4 class="mb-1">Recent Packets</h4>
      <div class="small text-muted">Live packet log with search, sort, and pagination.</div>
    </div>
  </div>
</div>

<div class="card p-3 glass mb-3">
  <form method="get" class="row g-2 align-items-end filter-form" data-reset="/traffic/">
    <div class="col-md-4">
      <label class="form-label small text-muted">Search</label>
      <input type="text" name="q" value="{{ search }}" class="form-control filter-input" placeholder="Src/Dst IP or flags">
    </div>
    <div class="col-md-3">
      <label class="form-label small text-muted">Sort</label>
      <select name="sort" class="form-select filter-input">
        <option value="-time" {% if sort == "-time" %}selected{% endif %}>Newest first</option>
        <option value="time" {% if sort == "time" %}selected{% endif %}>Oldest first</option>
        <option value="src" {% if sort == "src" %}selected{% endif %}>Src IP A→Z</option>
        <option value="-src" {% if sort == "-src" %}selected{% endif %}>Src IP Z→A</option>
        <option value="dst" {% if sort == "dst" %}selected{% endif %}>Dst IP A→Z</option>
        <option value="-dst" {% if sort == "-dst" %}selected{% endif %}>Dst IP Z→A</option>
        <option value="len" {% if sort == "len" %}selected{% endif %}>Length asc</option>
        <option value="-len" {% if sort == "-len" %}selected{% endif %}>Length desc</option>
      </select>
    </div>
    <div class="col-md-2">
      <label class="form-label small text-muted">Per page</label>
      <select name="per_page" class="form-select form-select-sm w-auto filter-input">
        {% for n in per_page_choices %}
          <option value="{{ n }}" {% if per_page == n %}selected{% endif %}>{{ n }}</option>
        {% endfor %}
      </select>
    </div>
    <div class="col-md-3 d-flex gap-2">
      <a class="btn btn-outline-secondary w-100" href="/traffic/">Reset</a>
    </div>
  </form>
</div>

<div class="card p-3 glass">
  <div class="table-responsive">
    <table class="table table-sm table-striped align-middle align-middle mb-0">
      <tr><th>Time (local)</th><th>Src</th><th>Dst</th><th>SPort</th><th>DPort</th><th>Flags</th><th>Len</th></tr>
      {% for p in packets %}
      <tr>
        <td><span title="{{ p.timestamp|localtime|date:'Y-m-d H:i:s' }}">{{ p.timestamp|human_time }}</span></td><td>{{ p.src_ip }}</td><td>{{ p.dst_ip }}</td>
        <td>{{ p.src_port }}</td><td>{{ p.dst_port }}</td><td>{{ p.flags }}</td><td>{{ p.length }}</td>
      </tr>
      {% empty %}
      <tr><td colspan="7">No packets</td></tr>
      {% endfor %}
    </table>
  </div>
  {% if packets.paginator.num_pages > 1 %}
  <div class="d-flex justify-content-between align-items-center mt-2">
    <div class="small text-muted">Page {{ packets.number }} of {{ packets.paginator.num_pages }}</div>
    <div class="btn-group">
      {% if packets.has_previous %}
        <a class="btn btn-outline-secondary btn-sm" href="?page={{ packets.previous_page_number }}&q={{ search }}&sort={{ sort }}&per_page={{ per_page }}">Prev</a>
      {% endif %}
      {% if packets.has_next %}
        <a class="btn btn-outline-secondary btn-sm" href="?page={{ packets.next_page_number }}&q={{ search }}&sort={{ sort }}&per_page={{ per_page }}">Next</a>
      {% endif %}
    </div>
  </div>
  {% endif %}
</div>
{% endblock %}

